---
import registryMeta from '../data/registry/meta.json';
import { kit } from '../lib/kit';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
}

const siteName = kit.site.title || 'MCP Tool Shop';

const {
  title,
  description = kit.site.description || 'Open-source tooling for local-first AI development.',
  currentPath = '',
  ogImage,
} = Astro.props;

const siteUrl = kit.site.url || 'https://mcptoolshop.com';
const canonicalUrl = new URL(currentPath || '/', siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;
const orgUrl = kit.org.url || 'https://github.com/mcp-tool-shop-org';

// Pages that already carry the site name keep their title verbatim.
const pageTitle = /mcp[- ]tool[- ]shop/i.test(title) ? title : `${title} · ${siteName}`;

const navLinks = [
  { href: '/tools/', label: 'Tools' },
  { href: '/releases/', label: 'Releases' },
  { href: '/newsletter/', label: 'Newsletter' },
  { href: '/about/', label: 'About' },
  { href: '/support/', label: 'Support' },
];

const meta = registryMeta as any;
const syncDate = meta.lastSyncAt
  ? new Date(meta.lastSyncAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="site-nav" aria-label="Primary">
      <div class="container">
        <a href="/" class="logo" aria-label={`${siteName} home`}>
          <img src="/mark.svg" alt="" width="22" height="22" class="logo-mark" />
          <span>{siteName}</span>
        </a>
        <ul class="nav-links">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href={orgUrl} rel="noopener" class="nav-external">GitHub</a>
          </li>
          {/* Lab navigation is opt-in for operators; see the toggle script below. */}
          <li id="admin-nav-item" style="display: none;">
            <a href="/lab/" style="color: #a78bfa; font-weight: 600;">Lab</a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <script is:inline>
      (function() {
        const KEY = "mcptoolshop_admin_nav";

        if (typeof window !== "undefined") {
            const url = new URL(window.location.href);
            if (url.searchParams.get("admin") === "1") {
                localStorage.setItem(KEY, "1");
                url.searchParams.delete("admin");
                window.history.replaceState({}, "", url.toString());
            }

            window.addEventListener("keydown", (e) => {
                if (e.ctrlKey && e.shiftKey && (e.key === "L" || e.key === "l")) {
                    const current = localStorage.getItem(KEY);
                    if (current === "1") {
                        localStorage.removeItem(KEY);
                        alert("Lab mode disabled");
                    } else {
                        localStorage.setItem(KEY, "1");
                        alert("Lab mode enabled");
                    }
                    window.location.reload();
                }
            });

            if (localStorage.getItem(KEY) === "1") {
                const el = document.getElementById("admin-nav-item");
                if (el) el.style.display = "block";
            }
        }
      })();
    </script>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <span>&copy; {new Date().getFullYear()} {siteName}. Open source under the MIT License.</span>
          <ul class="footer-links">
            <li><a href={orgUrl} rel="noopener">GitHub</a></li>
            <li><a href="https://www.npmjs.com/search?q=%40mcptoolshop" rel="noopener">npm</a></li>
            <li><a href="/trust/">Trust Center</a></li>
            <li><a href="/support/">Support</a></li>
            <li><a href="https://github.com/mcp-tool-shop-org/.github/blob/main/SECURITY.md" rel="noopener">Security</a></li>
          </ul>
        </div>
        <div class="footer-meta">
          <span>Catalog generated from the mcp-tool-shop-org organization on GitHub.</span>
          {syncDate && <span>Data refreshed {syncDate}</span>}
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-accent);
    color: var(--color-canvas-default);
    border-radius: var(--radius);
    z-index: 100;
  }

  .skip-link:focus {
    left: 0.75rem;
  }

  .site-nav .logo {
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-nav .logo-mark {
    display: block;
    width: 22px;
    height: 22px;
  }

  .nav-external {
    color: var(--color-text-muted);
  }
</style>
