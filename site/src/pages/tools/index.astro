---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';
import { kindLabel, laneLabel, ecosystemOf, shortDate, catalogTools, isDefaultTool } from '../../lib/labels';

// Registry entries whose repository no longer exists carry no GitHub data.
// They are catalog ghosts, not tools, so they are not rendered at all.
const catalog = catalogTools(projects as any[]);

// Default view: shipped and in-development repositories. Internal and archived
// repositories are reachable through the lane filter. Shared with start.astro
// so the two pages cannot quote different totals.
const isDefault = isDefaultTool;
const defaultCount = catalog.filter(isDefault).length;

const languages = [...new Set(catalog.map((p: any) => p.language).filter(Boolean))].sort();
const kinds = [...new Set(catalog.map((p: any) => p.kind).filter(Boolean))].sort();
const ecosystems = [...new Set(catalog.map((p: any) => ecosystemOf(p.install)).filter(Boolean))].sort();
const stabilities = ['stable', 'beta', 'experimental'];
---

<Base
  title="Tools"
  description="Browse MCP servers, command-line tools, libraries, and applications from MCP Tool Shop, with install commands for every published package."
  currentPath="/tools/"
>
  <div class="page-content tools-intro">
    <h1>Tools</h1>
    <p>
      {defaultCount} tools and libraries from the
      <a href="https://github.com/mcp-tool-shop-org" rel="noopener">mcp-tool-shop-org</a>
      organization. Install commands are shown wherever a package is published to npm or PyPI.
      Everything is open source under the MIT License.
    </p>
  </div>

  <div class="toolbar" role="search">
    <div class="search-wrapper">
      <label for="search" class="visually-hidden">Search tools</label>
      <input
        type="text"
        id="search"
        class="search-input"
        placeholder="Search by name, description, or topic"
        autocomplete="off"
      />
      <button id="search-clear" class="search-clear" aria-label="Clear search" hidden>&times;</button>
    </div>
    <div class="filter-group">
      <select id="filter-lane" class="filter-select" aria-label="Status">
        <option value="">Shipped and in development</option>
        <option value="shipped">Shipped only</option>
        <option value="active_lab">In development only</option>
        <option value="all">All repositories</option>
      </select>
      <select id="filter-eco" class="filter-select" aria-label="Package ecosystem">
        <option value="">Any ecosystem</option>
        {ecosystems.map((e: string) => <option value={e}>{e}</option>)}
      </select>
      <select id="filter-lang" class="filter-select" aria-label="Language">
        <option value="">Any language</option>
        {languages.map((lang: string) => <option value={lang}>{lang}</option>)}
      </select>
      <select id="filter-kind" class="filter-select" aria-label="Type">
        <option value="">Any type</option>
        {kinds.map((k: string) => <option value={k}>{kindLabel(k)}</option>)}
      </select>
      <select id="filter-stability" class="filter-select" aria-label="Stability">
        <option value="">Any stability</option>
        {stabilities.map((s: string) => <option value={s}>{s}</option>)}
      </select>
      <select id="sort-by" class="filter-select" aria-label="Sort">
        <option value="featured">Featured first</option>
        <option value="updated">Recently updated</option>
        <option value="name">Name A to Z</option>
        <option value="stars">Most starred</option>
      </select>
    </div>
  </div>

  <div class="results-count" id="results-count" aria-live="polite"></div>

  <div class="project-grid" id="project-grid">
    {catalog.map((project: any) => (
      <article
        class={`project-card${project.deprecated ? ' card-deprecated' : ''}`}
        data-name={project.name.toLowerCase()}
        data-desc={(project.tagline || project.description || '').toLowerCase()}
        data-repo={project.repo}
        data-lang={project.language || ''}
        data-kind={project.kind || ''}
        data-stability={project.stability || ''}
        data-lane={project.deprecated ? 'archived' : (project.lane || (project.registered ? 'shipped' : 'unlaned'))}
        data-eco={ecosystemOf(project.install)}
        data-featured={project.featured ? '1' : '0'}
        data-stars={project.stars || 0}
        data-updated={project.updatedAt || ''}
        data-tags={(project.tags || []).join(' ').toLowerCase()}
      >
        <div class="card-header">
          <h3>
            <a href={`/tools/${project.repo}/`}>{project.name}</a>
          </h3>
          <div class="card-badges">
            {project.deprecated && <span class="badge badge-deprecated">Archived</span>}
            {!project.deprecated && project.stability && (
              <span class={`badge badge-${project.stability}`}>{project.stability}</span>
            )}
            {!project.deprecated && project.lane === 'active_lab' && (
              <span class="badge badge-lane">{laneLabel('active_lab')}</span>
            )}
          </div>
        </div>
        <p>{project.tagline || project.description}</p>
        {project.install && <code class="install-line">{project.install}</code>}
        <div class="card-meta">
          {kindLabel(project.kind) && <span class="meta-item">{kindLabel(project.kind)}</span>}
          {project.language && <span class="meta-item">{project.language}</span>}
          {project.updatedAt && <span class="meta-item">Updated {shortDate(project.updatedAt)}</span>}
        </div>
      </article>
    ))}
  </div>

  <p class="empty-state" id="empty-state" hidden>No tools match these filters.</p>
</Base>

<style>
  .tools-intro {
    max-width: 720px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .toolbar {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 240px;
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: 0.875rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-clear {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0 0.25rem;
    line-height: 1;
  }

  .search-clear:hover {
    color: var(--color-text);
  }

  .filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-select {
    padding: 0.5rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
    outline: none;
  }

  .filter-select:focus {
    border-color: var(--color-accent);
  }

  .results-count {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card-header h3 {
    margin: 0;
  }

  .card-badges {
    display: flex;
    gap: 0.375rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    padding: 0.125em 0.5em;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .badge-stable {
    color: var(--color-success);
    background: var(--color-success-subtle);
  }

  .badge-beta {
    color: var(--color-attention-fg);
    background: var(--color-attention-subtle);
  }

  .badge-experimental {
    color: var(--color-danger-fg);
    background: var(--color-danger-subtle);
  }

  .badge-lane {
    color: var(--color-text-muted);
    background: rgba(139, 148, 158, 0.12);
  }

  .badge-deprecated {
    color: var(--color-danger-fg);
    background: var(--color-danger-subtle);
  }

  .card-deprecated {
    opacity: 0.6;
    border-style: dashed;
  }

  .install-line {
    display: block;
    margin: 0.5rem 0 1rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .project-card[hidden] {
    display: none;
  }

  .empty-state {
    color: var(--color-text-muted);
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-select {
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
  const grid = document.getElementById('project-grid')!;
  const cards = Array.from(grid.querySelectorAll('.project-card')) as HTMLElement[];
  const search = document.getElementById('search') as HTMLInputElement;
  const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
  const laneFilter = document.getElementById('filter-lane') as HTMLSelectElement;
  const ecoFilter = document.getElementById('filter-eco') as HTMLSelectElement;
  const langFilter = document.getElementById('filter-lang') as HTMLSelectElement;
  const kindFilter = document.getElementById('filter-kind') as HTMLSelectElement;
  const stabilityFilter = document.getElementById('filter-stability') as HTMLSelectElement;
  const sortBy = document.getElementById('sort-by') as HTMLSelectElement;
  const resultsCount = document.getElementById('results-count')!;
  const emptyState = document.getElementById('empty-state')!;

  const DEFAULT_LANES = new Set(['shipped', 'active_lab']);

  function laneMatches(cardLane: string, selected: string, hasQuery: boolean): boolean {
    if (selected === 'all') return true;
    if (selected) return cardLane === selected;
    // Default: shipped + in development. A search query widens to everything so
    // a visitor looking for a specific repo always finds it.
    return DEFAULT_LANES.has(cardLane) || hasQuery;
  }

  function applyFilters() {
    const q = search.value.toLowerCase().trim();
    const lane = laneFilter.value;
    const eco = ecoFilter.value;
    const lang = langFilter.value;
    const kind = kindFilter.value;
    const stability = stabilityFilter.value;

    clearBtn.hidden = !q;

    let visible = 0;
    for (const card of cards) {
      const d = card.dataset;
      const matchSearch = !q ||
        d.name!.includes(q) ||
        d.desc!.includes(q) ||
        d.repo!.includes(q) ||
        d.tags!.includes(q);
      const show = matchSearch &&
        laneMatches(d.lane || '', lane, Boolean(q)) &&
        (!eco || d.eco === eco) &&
        (!lang || d.lang === lang) &&
        (!kind || d.kind === kind) &&
        (!stability || d.stability === stability);
      card.hidden = !show;
      if (show) visible++;
    }

    resultsCount.textContent = visible === cards.length
      ? `${visible} tools`
      : `${visible} of ${cards.length} tools`;
    emptyState.hidden = visible > 0;
    applySort();
  }

  function applySort() {
    const mode = sortBy.value;
    const visibleCards = cards.filter((c) => !c.hidden);

    visibleCards.sort((a, b) => {
      switch (mode) {
        case 'featured': {
          const af = a.dataset.featured === '1' ? 1 : 0;
          const bf = b.dataset.featured === '1' ? 1 : 0;
          if (af !== bf) return bf - af;
          return (b.dataset.updated || '').localeCompare(a.dataset.updated || '');
        }
        case 'updated':
          return (b.dataset.updated || '').localeCompare(a.dataset.updated || '');
        case 'stars':
          return (+(b.dataset.stars || 0)) - (+(a.dataset.stars || 0));
        case 'name':
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        default:
          return 0;
      }
    });

    for (const card of visibleCards) grid.appendChild(card);
  }

  search.addEventListener('input', applyFilters);
  clearBtn.addEventListener('click', () => { search.value = ''; applyFilters(); search.focus(); });
  for (const el of [laneFilter, ecoFilter, langFilter, kindFilter, stabilityFilter, sortBy]) {
    el.addEventListener('change', applyFilters);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== search) {
      e.preventDefault();
      search.focus();
    }
  });

  applyFilters();
</script>
