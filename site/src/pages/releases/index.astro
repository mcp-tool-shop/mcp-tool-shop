---
import Base from '../../layouts/Base.astro';
import releases from '../../data/releases.json';
import projects from '../../data/projects.json';
import registryMeta from '../../data/registry/meta.json';
import { plainText, relativeDate, shortDate } from '../../lib/labels';

const projectRepos = new Set((projects as any[]).map((p: any) => p.repo));
const refreshed = shortDate((registryMeta as any).lastSyncAt);

const entries = (releases as any[]).map((rel: any) => ({
  ...rel,
  bullets: (rel.body || [])
    .map((b: string) => plainText(b))
    .filter((b: string) => b && !/^https?:\/\/\S+$/.test(b))
    .slice(0, 4),
}));
---

<Base
  title="Releases"
  description="Tagged releases across the mcp-tool-shop-org organization, newest first."
  currentPath="/releases/"
>
  <div class="page-content releases-intro">
    <h1>Releases</h1>
    <p>
      Tagged releases across the
      <a href="https://github.com/mcp-tool-shop-org" rel="noopener">mcp-tool-shop-org</a>
      organization, newest first. Each entry links to the release on GitHub.
      {refreshed && <span>Catalog data refreshed {refreshed}.</span>}
    </p>
  </div>

  <div class="release-feed">
    {entries.map((rel: any) => (
      <article class="release-entry">
        <div class="release-header">
          {projectRepos.has(rel.repo) ? (
            <a href={`/tools/${rel.repo}/`} class="release-tool">{rel.toolName}</a>
          ) : (
            <span class="release-tool release-tool--orphan">{rel.toolName}</span>
          )}
          <a href={rel.url} class="release-tag" rel="noopener">
            {rel.tag}
            {rel.prerelease && <span class="badge-pre">pre-release</span>}
          </a>
          <time class="release-date" datetime={rel.publishedAt} title={shortDate(rel.publishedAt)}>
            {relativeDate(rel.publishedAt)}
          </time>
        </div>
        {rel.name && rel.name !== rel.tag && rel.name !== `${rel.toolName} ${rel.tag}` && (
          <p class="release-name">{rel.name}</p>
        )}
        {rel.bullets.length > 0 && (
          <ul class="release-bullets">
            {rel.bullets.map((bullet: string) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>

  {entries.length === 0 && (
    <p class="empty-state">No releases have been synced yet.</p>
  )}
</Base>

<style>
  .releases-intro {
    max-width: 720px;
  }

  .release-feed {
    margin-top: 1rem;
    max-width: 760px;
  }

  .release-entry {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .release-entry:first-child {
    padding-top: 0;
  }

  .release-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .release-tool {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-accent);
  }

  .release-tool--orphan {
    color: var(--color-text-muted);
  }

  .release-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
    background: var(--color-surface);
    padding: 0.125em 0.5em;
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }

  .release-tag:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .badge-pre {
    font-size: 0.5625rem;
    color: var(--color-attention-fg);
    background: var(--color-attention-subtle);
    padding: 0.1em 0.4em;
    border-radius: 2px;
    margin-left: 0.375rem;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .release-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .release-name {
    font-size: 0.875rem;
    color: var(--color-text);
    margin-top: 0.5rem;
  }

  .release-bullets {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .release-bullets li {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    line-height: 1.55;
  }

  .empty-state {
    color: var(--color-text-muted);
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .release-date {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
